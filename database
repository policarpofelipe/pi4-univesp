CREATE DATABASE IF NOT EXISTS atendimento
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

USE atendimento;

DROP TABLE IF EXISTS atendimentos;

CREATE TABLE atendimentos (
    id                          BIGINT UNSIGNED AUTO_INCREMENT,
    protocolo                   INT UNSIGNED NOT NULL,
    id_ticket                   SMALLINT UNSIGNED NULL,

    origem                      VARCHAR(10) NOT NULL,
    contact_id                  VARCHAR(20) NULL,
    conexao                     VARCHAR(10) NOT NULL,
    user_id                     VARCHAR(20) NOT NULL,

    criado                      DATETIME NOT NULL,
    iniciado                    DATETIME NOT NULL,
    fim                         DATETIME NOT NULL,

    tempo_espera_segundos       INT UNSIGNED NOT NULL,
    tempo_atendimento_segundos  INT UNSIGNED NOT NULL,

    setores                     VARCHAR(20) NOT NULL,
    setores_transfers           VARCHAR(100) NULL,

    rating                      TINYINT UNSIGNED NULL,
    tags                        VARCHAR(50) NULL,

    PRIMARY KEY (id),

    UNIQUE KEY uk_protocolo (protocolo),

    KEY idx_criado (criado),
    KEY idx_id_ticket (id_ticket),
    KEY idx_contact_id (contact_id),
    KEY idx_user_criado (user_id, criado),

    CONSTRAINT chk_rating
        CHECK (rating IS NULL OR rating BETWEEN 1 AND 5),

    CONSTRAINT chk_datas
        CHECK (iniciado >= criado AND fim >= iniciado)
)
ENGINE = InnoDB
DEFAULT CHARACTER SET = utf8mb4
COLLATE = utf8mb4_unicode_ci;


