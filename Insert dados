CREATE DATABASE IF NOT EXISTS atendimento CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE atendimento;

DROP TABLE IF EXISTS atendimentos;

CREATE TABLE atendimentos (
    id                          INT AUTO_INCREMENT PRIMARY KEY,
    protocolo                   INT NOT NULL,
    id_ticket                   INT NULL,
    origem                      VARCHAR(30) NOT NULL,
    contact_id                  VARCHAR(50) NULL,
    conexao                     VARCHAR(50) NULL,
    user_id                     VARCHAR(50) NOT NULL,
    criado                      DATETIME NOT NULL,
    iniciado                    DATETIME NOT NULL,
    fim                         DATETIME NOT NULL,
    tempo_espera_segundos       INT NULL,
    tempo_atendimento_segundos  INT NULL,
    setores                     VARCHAR(255) NULL,
    setores_transfers           TEXT NULL,
    rating                      TINYINT NULL,
    avaliacao                   INT NULL,
    tags                        VARCHAR(255) NULL,
    interacoes                  INT NOT NULL DEFAULT 0,
    INDEX idx_protocolo (protocolo),
    INDEX idx_user_id (user_id),
    INDEX idx_contact_id (contact_id),
    INDEX idx_criado (criado)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


